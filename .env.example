# BMSIT AI Agent configuration.
#
# Copy to .env and fill in. EVERY variable below is required: there are no
# defaults in code. If one is missing, startup fails and names it. This is
# deliberate, so this file is always the truth about how the system behaves.

# --- API keys ---------------------------------------------------------------
# GEMINI_API_KEY   used for chat answers.
# GEMINI_API_KEYS  comma-separated pool used for embeddings. More keys means
#                  more daily embedding quota for the first bulk load. Requests
#                  rotate across them and any key reporting a quota error is
#                  parked for EMBED_KEY_COOLDOWN seconds while the run continues
#                  on the others.
# Both may be empty: the app still runs, using weaker local vectors.
GEMINI_API_KEY=
GEMINI_API_KEYS=

# --- Token strategy ---------------------------------------------------------
# These four settings are what make a 1,000+ page site fit in a free quota.
#
# EMBED_CACHE_ENABLED reuses the vector for any text already embedded before,
#   at zero token cost. College sites repeat text heavily, so a large crawl
#   usually contains only a few hundred pages of genuinely distinct content.
#   It also makes re-uploads and resumed runs almost free.
# EMBED_DAILY_TOKEN_BUDGET stops a run deliberately once the day's allowance is
#   spent, instead of crashing into HTTP 429. Set it just under your real quota
#   to leave headroom for query embeddings. 0 = unlimited.
# SCRAPE_MIN_PAGE_TOKENS drops pages too thin to answer anything.
# CHUNK_TARGET_TOKENS: larger chunks mean fewer chunks, so the per-chunk page
#   header and the overlap are repeated far less often.
EMBED_CACHE_ENABLED=true
EMBED_CACHE_MAX_VECTORS=200000
EMBED_DAILY_TOKEN_BUDGET=800000
SCRAPE_MIN_PAGE_TOKENS=80

# --- Chunking (token based) -------------------------------------------------
CHUNK_TARGET_TOKENS=450
CHUNK_MAX_TOKENS=550
# Chunks smaller than this are merged into the previous one.
CHUNK_MIN_TOKENS=60
# Must be < CHUNK_TARGET_TOKENS. Every overlap token is paid for twice.
CHUNK_OVERLAP_TOKENS=30

# --- Embeddings -------------------------------------------------------------
EMBED_MODEL=gemini-embedding-001
# Vector width. Changing this invalidates the index and forces a full re-embed.
EMBEDDING_DIM=768
# Per-request ceilings. Both are enforced, whichever binds first.
EMBED_MAX_BATCH_TEXTS=100
EMBED_MAX_BATCH_TOKENS=20000
# Longest single input; must be >= CHUNK_MAX_TOKENS.
EMBED_MAX_INPUT_TOKENS=2048
# Parallel in-flight requests.
EMBED_MAX_CONCURRENCY=2
EMBED_TIMEOUT=60
EMBED_RETRIES=2
# Minimum seconds between two calls on the same key (per-minute rate limits).
EMBED_MIN_INTERVAL=0.5
# How long a key rests after a quota error.
EMBED_KEY_COOLDOWN=3600
# Chunks per committed slice. Smaller means finer-grained resume, at the cost
# of more index writes.
EMBED_COMMIT_SLICE_CHUNKS=200
# Cap on chunks embedded in one run. 0 = unlimited.
EMBED_MAX_CHUNKS_PER_RUN=0

# --- Crawler ----------------------------------------------------------------
BMSIT_DEFAULT_URL=https://bmsit.ac.in/
SCRAPE_DEPTH=5
SCRAPE_MAX_PAGES=1000
# Lines appearing on more than this fraction of pages are treated as site
# navigation and stripped before chunking.
SCRAPE_BOILERPLATE_RATIO=0.30
SCRAPE_REQUEST_TIMEOUT=10
# Politeness delay between page fetches, in seconds.
SCRAPE_DELAY=0.12

# --- Daily delta run --------------------------------------------------------
SCHEDULE_TIME=07:00
SCHEDULE_TIMEZONE=Asia/Kolkata

# --- Retrieval / chat -------------------------------------------------------
TOP_K=8
CHAT_TIMEOUT=45
CHAT_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash,gemini-3.8-flash

# --- Supabase Vector Store (pgvector) ---------------------------------------
# Supply credentials to use Supabase PostgreSQL + pgvector as vector store.
# If unset, local FAISS vector store is used as a fallback.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_TABLE=vectors
SUPABASE_DB_URL=

# --- Server -----------------------------------------------------------------
# 127.0.0.1 for local use. Render and other platforms require 0.0.0.0.
HOST=127.0.0.1
PORT=5000
DEBUG=false
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-long-random-string
